        <height>16</height>
       </rect>
      </property>
      <property name="toolTip">
       <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Si un décalage de service du ralenti a été configuré dans cet ECU, l'écart par rapport au ralenti normal est affiché ici. Normalement, seules deux valeurs sont possibles : 0 tr/min ou 49 tr/min. Ce décalage peut être configuré via la fonction de la section AUTRE.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
      </property>
      <property name="text">
       <string>consigne ralenti</string>
      </property>
     </widget>
