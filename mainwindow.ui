        <y>246</y>
        <width>125</width>
        <height>16</height>
       </rect>
      </property>
      <property name="toolTip">
       <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Affiche la position du papillon obtenue par l'ECU MEMS via le potentiomètre de papillon. Cette valeur doit passer d'une valeur basse à une valeur haute lorsque la pédale d'accélérateur est enfoncée.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
      </property>
      <property name="text">
       <string>angle papillon</string>
      </property>
     </widget>
     <widget class="QLabel" name="label_7">
